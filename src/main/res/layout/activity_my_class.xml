<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background8"
    android:orientation="vertical"

    tools:context=".MainActivity">

        <TextView
            android:id="@+id/tvName"
            style="@android:style/Widget.TextView.PopupMenu"
            android:layout_width="match_parent"
            android:layout_height="76dp"
            android:layout_gravity="top"
            android:elegantTextHeight="true"
            android:fontFamily="serif-monospace"
            android:fontStyle="italic"
            android:gravity="top"
            android:scrollbarStyle="insideOverlay"
            android:text="כיתת לימוד"
            android:textAlignment="center"
            android:textAllCaps="true"
            android:textColor="@color/CadetBlue"
            android:textSize="60dp"
            android:textStyle="bold" />

    <TextView
        android:id="@+id/tvNull1"
        android:layout_width="10dp"
        android:layout_height="42dp"
        android:textAlignment="textStart"
        android:textSize="20dp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="315dp"
        android:layout_height="31dp"
        android:layout_gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv1Subject"
            android:layout_width="196dp"
            android:layout_height="wrap_content"
            android:layout_marginRight="20sp"
            android:text="מקצוע:"
            android:textColor="#696969"
            android:textAlignment="textStart"
            android:textSize="20dp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvNull3"
            android:layout_width="61dp"
            android:layout_height="3dp"
            android:textAlignment="textStart"
            android:textSize="20dp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/ibDelete"
            android:layout_width="35dp"
            android:layout_height="wrap_content"
            android:layout_marginRight="10sp"
            android:layout_weight="1"
            android:background="#d1d1d1"
            android:src="@android:drawable/ic_menu_delete" />


    </LinearLayout>

    <TextView
        android:id="@+id/tvSubject"
        style="@android:style/Widget.Holo.Light.Button"
        android:layout_width="340dp"
        android:layout_height="45dp"
        android:layout_gravity="center"
        android:background="@drawable/blackoutline3"
        android:ems="10"
        android:inputType="textMultiLine"
        android:textColor="@color/Black"
        android:textAlignment="viewStart"
        tools:ignore="RtlCompat" />

        <TextView
            android:id="@+id/tv1View"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="20dp"
            android:layout_marginRight="50sp"
            android:text="תיאור:"
            android:textColor="#696969"
            android:textAlignment="textStart"
            android:textStyle="bold" />

    <TextView
        android:id="@+id/tvView"
        style="@android:style/Widget.Holo.Light.Button"
        android:layout_width="340dp"
        android:layout_height="45dp"
        android:layout_gravity="center"
        android:background="@drawable/blackoutline3"
        android:ems="10"
        android:inputType="textMultiLine"
        android:textColor="@color/Black"
        android:textAlignment="viewStart"
        tools:ignore="RtlCompat" />

        <TextView
            android:id="@+id/tv1Date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="20dp"
            android:layout_marginRight="50sp"
            android:text="תאריכים ללמידה:"
            android:textColor="#696969"
            android:textAlignment="textStart"
            android:textStyle="bold" />

    <TextView
        android:id="@+id/tvDate"
        style="@android:style/Widget.Holo.Light.Button"
        android:layout_width="340dp"
        android:layout_height="45dp"
        android:layout_gravity="center"
        android:background="@drawable/blackoutline3"
        android:ems="10"
        android:textColor="@color/Black"
        android:inputType="textMultiLine"
        android:textAlignment="viewStart"
        tools:ignore="RtlCompat" />

    <TextView
            android:id="@+id/tv1Time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="20dp"
            android:layout_marginRight="50sp"
            android:text="שעת ההתראה:"
        android:textColor="#696969"
            android:textAlignment="textStart"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="338dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvTime"
                style="@android:style/Widget.Holo.Light.Button"
                android:layout_width="307dp"
                android:layout_height="45dp"
                android:layout_gravity="center"
                android:layout_weight="1"
                android:background="@drawable/blackoutline3"
                android:ems="10"
                android:inputType="textMultiLine"
                android:textColor="@color/Black"
                android:textAlignment="viewStart"
                tools:ignore="RtlCompat" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="324dp"
            android:layout_height="81dp"
            android:layout_gravity="center"
            android:orientation="horizontal">


            <Button
                android:id="@+id/btnPictures"
                style="@android:style/Widget.Holo.Light.Button"
                android:layout_width="155dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:background="@drawable/blackoutline2"
                android:text="תמונות"
                android:textSize="30sp"
                android:textStyle="bold" />


            <TextView
                android:id="@+id/tvNull2"
                android:layout_width="10dp"
                android:layout_height="wrap_content"
                android:textAlignment="textStart"
                android:textSize="20dp"
                android:textStyle="bold" />


            <Button
                android:id="@+id/btnDocs"
                style="@android:style/Widget.Holo.Light.Button"
                android:layout_width="155dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:background="@drawable/blackoutline2"
                android:text="מסמכים"
                android:textSize="30sp"
                android:textStyle="bold" />
        </LinearLayout>

    <TextView
        android:id="@+id/tvNull4"
        android:layout_width="10dp"
        android:layout_height="42dp"
        android:textAlignment="textStart"
        android:textSize="20dp"
        android:textStyle="bold" />

    <ImageView
        android:contentDescription="Hourglass"
        android:id="@+id/hourglassAnimation"
        android:layout_width="120sp"
        android:layout_height="190sp"
        android:layout_gravity="center"/>
</LinearLayout>

