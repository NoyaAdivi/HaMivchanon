<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background12"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/tvName"
        style="@android:style/Widget.TextView.PopupMenu"
        android:layout_width="391dp"
        android:layout_height="76dp"
        android:layout_gravity="top"
        android:elegantTextHeight="true"
        android:fontFamily="serif-monospace"
        android:fontStyle="italic"
        android:gravity="top"
        android:scrollbarStyle="insideOverlay"
        android:text="תזכורות חדשות"
        android:textAlignment="center"
        android:textAllCaps="false"
        android:textColor="#696969"
        android:textSize="50dp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvNull1"
        android:layout_width="10dp"
        android:layout_height="39dp"
        android:textAlignment="textStart"
        android:textSize="20dp"
        android:textStyle="bold" />

    <TextView
    android:id="@+id/tvSubject"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="20dp"
        android:layout_marginRight="50sp"
    android:text="מקצוע:"
        android:textColor="#696969"
    android:textAlignment="textStart"
    android:textStyle="bold" />

    <EditText
        android:id="@+id/etSubject"
        style="@android:style/Widget.Holo.Light.Button"
        android:layout_width="340dp"
        android:layout_height="45dp"
        android:layout_gravity="center"
        android:background="@drawable/blackoutline3"
        android:ems="10"
        android:hint=" הזן מקצוע"
        android:textColorHint="@color/Black"
        android:textColorHighlight="@color/Black"
        android:outlineAmbientShadowColor="@color/Black"
        android:textColorLink="@color/Black"
        android:textColor="@color/Black"
        android:inputType="textMultiLine"
        android:textAlignment="textStart"
        android:textSize="16sp"
        tools:ignore="RtlCompat" />

    <TextView
        android:id="@+id/tvView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="20dp"
        android:layout_marginRight="50sp"
        android:text="תיאור:"
        android:textColor="#696969"
        android:textAlignment="textStart"
        android:textStyle="bold" />

    <Spinner
        android:id="@+id/spView"
        style="@android:style/Widget.Holo.Light.Button"
        android:layout_width="340dp"
        android:layout_height="45dp"
        android:ems="10"
        android:spinnerMode="dropdown"
        android:outlineAmbientShadowColor="@color/Black"
        android:outlineSpotShadowColor="@color/Black"
        android:textColor="@color/Black"
        android:background="@drawable/blackoutline6"
        android:inputType="textMultiLine"
        android:layout_gravity="center"
        />


    <TextView
        android:id="@+id/tvDate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="20dp"
        android:layout_marginRight="50sp"
        android:text="תאריכים ללמידה:"
        android:textColor="#696969"
        android:textAlignment="textStart"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvFromDate"
        style="@android:style/Widget.Holo.Light.Button"
        android:layout_width="340dp"
        android:layout_height="45dp"
        android:layout_gravity="center"
        android:background="@drawable/blackoutline3"
        android:ems="10"
        android:inputType="textMultiLine"
        android:text=" בחר תאריך התחלה"
        android:textAlignment="textStart"
        android:textSize="16sp"
        tools:ignore="RtlCompat" />

    <TextView
        android:id="@+id/tvToDate"
        style="@android:style/Widget.Holo.Light.Button"
        android:layout_width="340dp"
        android:layout_height="45dp"
        android:layout_gravity="center"
        android:background="@drawable/blackoutline3"
        android:ems="10"
        android:inputType="textMultiLine"
        android:text=" בחר תאריך סיום"
        android:textAlignment="textStart"
        android:textSize="16sp"
        tools:ignore="RtlCompat" />


    <LinearLayout
        android:layout_width="340dp"
        android:layout_height="31dp"
        android:layout_gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvTTime"
            android:layout_width="196dp"
            android:layout_height="wrap_content"
            android:layout_marginRight="20sp"
            android:text="שעות ללמידה:"
            android:textAlignment="textStart"
            android:textColor="#696969"
            android:textSize="20dp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvNull2"
            android:layout_width="61dp"
            android:layout_height="3dp"
            android:textAlignment="textStart"
            android:textSize="20dp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/ibPlus"
            android:layout_width="43dp"
            android:layout_height="wrap_content"
            android:layout_marginRight="10sp"
            android:background="#d1d1d1"
            android:layout_weight="1"
            android:src="@android:drawable/ic_input_add" />


    </LinearLayout>


    <TextView
        android:id="@+id/tvTime1"
        style="@android:style/Widget.Holo.Light.Button"
        android:layout_width="340dp"
        android:layout_height="45dp"
        android:layout_gravity="center"
        android:background="@drawable/blackoutline3"
        android:ems="10"
        android:inputType="textMultiLine"
        android:text=" בחר שעה לתזכורת"
        android:textAlignment="textStart"
        android:textSize="16sp"
        tools:ignore="RtlCompat" />

    <TextView
        android:id="@+id/tvTime2"
        style="@android:style/Widget.Holo.Light.Button"
        android:layout_width="340dp"
        android:layout_height="45dp"
        android:layout_gravity="center"
        android:background="@drawable/blackoutline3"
        android:ems="10"
        android:inputType="textMultiLine"
        android:text=" בחר שעה לתזכורת שניה"
        android:textAlignment="textStart"
        android:textSize="16sp"
        android:visibility="invisible"
        tools:ignore="RtlCompat" />

    <TextView
        android:id="@+id/tvTime3"
        style="@android:style/Widget.Holo.Light.Button"
        android:layout_width="340dp"
        android:layout_height="45dp"
        android:layout_gravity="center"
        android:background="@drawable/blackoutline3"
        android:ems="10"
        android:inputType="textMultiLine"
        android:text=" בחר שעה לתזכורת שלישית"
        android:textAlignment="textStart"
        android:textSize="16dp"
        tools:ignore="RtlCompat"
        android:visibility="invisible"/>/>

    <TextView
        android:id="@+id/tvNull3"
        android:layout_width="10dp"
        android:layout_height="15dp"
        android:textAlignment="textStart"
        android:textSize="20dp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnFinish"
        style="@android:style/Widget.Holo.Light.Button"
        android:layout_width="120dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/blackoutline2"
        android:text="סיימתי"
        android:textSize="30sp"
        android:textStyle="bold" />

</LinearLayout>