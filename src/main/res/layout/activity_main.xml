<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/tvNull"
        android:layout_width="342dp"
        android:layout_height="30sp"
        android:textSize="25sp"
        android:textStyle="bold"
        />

    <TextView
        android:id="@+id/tvName"
        style="@android:style/Widget.TextView.PopupMenu"
        android:layout_width="391dp"
        android:layout_height="91dp"
        android:fontFamily="serif-monospace"
        android:fontStyle="italic"
        android:scrollbarStyle="insideOverlay"
        android:text="המבחנון"
        android:textAlignment="center"
        android:textAllCaps="true"
        android:textColor="@color/CadetBlue"
        android:textSize="80dp"
        android:textStyle="bold" />

    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/ivLogo"
        android:layout_width="match_parent"
        android:layout_height="209dp"
       app:lottie_autoPlay="true"
        app:lottie_loop="true"
        app:lottie_fileName="clock-animation2.json"/>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="61dp"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/ibEnterMail"
            android:layout_width="41dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="#d1d1d1"
            android:src="@android:drawable/ic_dialog_email" />



        <EditText
            android:id="@+id/etEmail"
            style="@android:style/Widget.AutoCompleteTextView"
            android:layout_width="310dp"
            android:layout_height="wrap_content"
            android:textColor="@color/Black"
            android:layout_weight="1"
            android:ems="10"
            android:fontFamily="monospace"
            android:inputType="textEmailAddress"
            android:lineSpacingExtra="36sp"
            android:text="נא הקלד את האימייל שלך"
            android:textAlignment="viewEnd"
            android:textSize="20sp"

            android:textStyle="normal" />
    </LinearLayout>


    <Button
        android:id="@+id/btnMyReminder"
        style="@android:style/Widget.Holo.Light.Button"
        android:layout_width="376dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/blackoutline"
        android:elevation="22dp"
        android:fontFamily="serif"
        android:text="התזכורות שלי"
        android:textAlignment="center"
        android:textSize="30sp"
        android:visibility="visible" />

    <Button
        android:id="@+id/btnNewReminder"
        style="@android:style/Widget.Holo.Light.Button"
        android:layout_width="373dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="10dp"
        android:background="@drawable/blackoutline"
        android:elevation="12dp"
        android:fontFamily="serif"
        android:text="תזכורת חדשה"
        android:textAlignment="center"
        android:textSize="30sp"
        android:textStyle="normal" />


</LinearLayout>